# ignore Python cache files
*__pycache__
# ignore VSCode settings and workspace files
.vscode/

reference_repositories/*

# ignore heavy data files but keep .gitkeep files for directory structure
data/splits/*
!data/splits/.gitkeep
data/datasets/*
!data/datasets/.gitkeep
data/feature_svd/*
!data/feature_svd/.gitkeep
data/induced_subgraphs/*
!data/induced_subgraphs/.gitkeep
data/subgraph_svd/*
!data/subgraph_svd/.gitkeep
data/anygraph_data/*
!data/anygraph_data/.gitkeep
data/filter/*
!data/filter/.gitkeep

# ignore trained model checkpoints and outputs but keep .gitkeep files for directory structure
trained_models/*
!trained_models/.gitkeep

# ignore pretrained models checkpoints but keep .gitkeep files for directory structure
pretrained_models/*
!pretrained_models/.gitkeep

# ignore finetuned models checkpoints but keep .gitkeep files for directory structure
finetuned_models/*
!finetuned_models/.gitkeep

# ignore outputs but keep .gitkeep files for directory structure
outputs/*
!outputs/.gitkeep

# ignore generated context but keep .gitkeep files for directory structure
generated_context/dataset/*
!generated_context/dataset/.gitkeep
generated_context/llm/*
!generated_context/llm/.gitkeep
generated_context/graph_condensation/*
!generated_context/graph_condensation/.gitkeep

# ignore router datasets but keep .gitkeep files for directory structure
router_datasets/*
!router_datasets/.gitkeep
!router_datasets/records/.gitkeep
!router_datasets/graph/.gitkeep

# ignore router selection checkpoints and outputs but keep .gitkeep files for directory structure
router_selection/*
!router_selection/.gitkeep
!router_selection/checkpoints/.gitkeep
!router_selection/outputs/.gitkeep

# ignore router prediction checkpoints and outputs but keep .gitkeep files for directory structure
router_prediction/*
!router_prediction/.gitkeep

# ignore slurm outputs but keep .gitkeep files for directory structure
slurm/output/*
!slurm/output/.gitkeep

# ignore Hugging Face related files but keep operation.sh for Hugging Face integration
huggingface/*
!huggingface/operation.sh

# ignore folder where we store the official implementations for comparison
baselines/*
